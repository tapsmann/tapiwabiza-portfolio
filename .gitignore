# See https://github.com/TypeScript/TypeScript/wiki/Ignoring-TypeScript-Compiled-Files
*.tsbuildinfo
*.tsx
*.ts

# See https://gist.github.com/poeto/1b88e36b22f2fba9148b
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directory for all generated compiler artifacts
.next/
.out/

# Dependency-based dirs - NODE_MODULES
node_modules/

# Optional npm cache directory
.pnpm.pnpm.yarn.npmrc.lock
yarn.lock*
package-lock.json*

# Optional
next-env.d.ts

# Vercel
.vercel

# Code scaffolding files
*.spec.*
*.test.*

# Bundle analyzer files
report-web-vitals.*

# storybook
.env.local
.env.development.local
.env.production.local

# debug
*.debug.*